{
  "description": "50 benchmark combos for best_path analysis; each is run in planner and rule_based modes.",
  "rationale": {
    "targets": "Sampled within the ~10th-90th percentile band of data/seeds/energetic_seed_library.csv (77 seeds): density 1.45-1.95 g/cm3 (seed median 1.76), det_velocity ~6500-9500 m/s (median 7806), det_pressure ~17.5-40.5 GPa (median 27.7), hf_solid -130..+100 kJ/mol (10th pct -132, 90th pct +90). Velocity and pressure scale with density (as in Kamlet-Jacobs) with small noise so targets are physically consistent rather than impossible combinations.",
    "beam": "depth in {3,4,5,6,8}, width in {3,4,5,6,8}, top_k in {2,3,4,5} cycled with different periods so all values co-occur; depth <= 8 keeps per-run cost to seconds-to-minutes on a CPU (worst case 8x8x5 expansions). random_seed 1000-1049, unique per combo.",
    "fixed": "early_stop_on_mape=false so every run attempts the full depth; literature lookup on, patent/online search off for reproducibility and no network.",
    "generator": "random.Random(20261017)"
  },
  "fixed_beam": {
    "mape_threshold": 1.0,
    "enable_literature": true,
    "enable_patent_search": false,
    "novelty_as_gate": false,
    "early_stop_on_mape": false
  },
  "modes": [
    "planner",
